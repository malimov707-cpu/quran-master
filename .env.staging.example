APP_NAME="Qur'on AI Ustoz Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.uz

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quran_ai_ustoz_staging
DB_USERNAME=quran_staging
DB_PASSWORD=

CACHE_STORE=redis
