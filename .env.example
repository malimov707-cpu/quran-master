APP_NAME="Qur'on AI Ustoz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Asia/Tashkent

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BACKUPS_BUCKET=
AWS_BACKUPS_ENDPOINT=
AWS_BACKUPS_ACCESS_KEY_ID=
AWS_BACKUPS_SECRET_ACCESS_KEY=
AWS_BACKUPS_DEFAULT_REGION=us-east-1
AWS_BACKUPS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_TIMEOUT_SECONDS=3600

VITE_APP_NAME="${APP_NAME}"
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
AI_MIN_CONFIDENCE=0.85
FCM_SERVER_KEY=
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
